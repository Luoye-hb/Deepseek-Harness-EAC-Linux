{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": false
  },
  "include": ["lib/**/*.ts", "shared/**/*.ts", "preload/**/*.ts", "host-bootstrap.ts", "client-updater.ts", "logger.ts", "plugin-guard.ts", "preload.ts", "types-*.d.ts"],
  "exclude": ["node_modules", "vendor", "dist", "out", "assets", "docs"]
}
